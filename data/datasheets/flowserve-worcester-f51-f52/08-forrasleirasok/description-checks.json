      "missing": false,
      "description_sentences": 1,
      "use_for_sentences": 1,
      "ungrounded_numbers": [],
      "uncertain": "The footnote texts (MAST stem material, break-to-open test conditions, AUTOSIZE 4.3) are printed below the table and are not part of the Azure table content."
    },
