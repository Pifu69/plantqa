<urn:plantdocs:swagelok-ms-01-176:source:page_text_6> a plm:PCA_100029513 ;
    dcterms:type "text_section" ;
    plm:PCA_100029521 "(page 6 text)" ;
    plm:PCA_100029534 "swagelok-ms-01-176.pdf" ;
    schema:pageStart 6 .

<urn:plantdocs:swagelok-ms-01-176:source:section_11> a plm:PCA_100029513 ;
    dcterms:description "Notes to the CH series pressure-temperature ratings: based on fluorocarbon FKM seals; see Swagelok Tubing Data MS-01-107 for tube fitting end connections; ratings may be limited by the end connection (Dimensions, page 12)."@en ;
    dcterms:type "text_section" ;
    plm:PCA_100029521 "CH Series" ;
    plm:PCA_100029534 "swagelok-ms-01-176.pdf" ;
    skos:scopeNote "Answers what seal material the CH ratings assume and that the end connection can limit the rating."@en ;
    schema:pageStart 3 .

<urn:plantdocs:swagelok-ms-01-176:source:section_27> a plm:PCA_100029513 ;
    dcterms:description "Cleaning and Packaging: C, CA and CH valves with VCR or VCO end connections are processed to Swagelok SC-11 (MS-06-63, ASTM G93 Level C); all other C, CA, CH valves and all CP and CPA valves are cleaned to SC-10 (MS-06-62)."@en ;
    dcterms:type "text_section" ;
    plm:PCA_100029521 "Cleaning and Packaging" ;
    plm:PCA_100029534 "swagelok-ms-01-176.pdf" ;
    skos:scopeNote "Answers which cleaning and packaging specification applies to a given series and end connection."@en ;
    schema:pageStart 10 .

<urn:plantdocs:swagelok-ms-01-176:source:section_28> a plm:PCA_100029513 ;
    dcterms:description "Dimensions note on page 11: dimensions are shown with Swagelok tube fitting nuts finger-tight, for reference only and subject to change."@en ;
    dcterms:type "text_section" ;
    plm:PCA_100029521 "Dimensions" ;
    plm:PCA_100029534 "swagelok-ms-01-176.pdf" ;
    skos:scopeNote "Answers how the dimensions in the C and CA dimensions table are to be read."@en ;
    schema:pageStart 11 .

<urn:plantdocs:swagelok-ms-01-176:source:section_47> a plm:PCA_100029513 ;
    dcterms:description "Seal material option for all series: FKM O-rings standard in 316 SS valves, Buna N in brass valves; other elastomer seals available by inserting the seal material designator into the ordering number."@en ;
    dcterms:type "text_section" ;
    plm:PCA_100029521 "Seal Materials (All Series)" ;
    plm:PCA_100029534 "swagelok-ms-01-176.pdf" ;
    skos:scopeNote "Answers which seal material is standard and how to order another one."@en ;
    schema:pageStart 14 .

<urn:plantdocs:swagelok-ms-01-176:source:section_59> a plm:PCA_100029513 ;
    dcterms:description "C, CP, CA and CPA seal kits: contain an O-ring and instructions; for PTFE kits replace the material designator with T and omit the durometer number (example T-4C-K4)."@en ;
    dcterms:type "text_section" ;
    plm:PCA_100029521 "C, CP, CA, and CPA Series Seal Kits" ;
    plm:PCA_100029534 "swagelok-ms-01-176.pdf" ;
    skos:scopeNote "Answers what a seal kit contains and how to order a PTFE seal kit."@en ;
    schema:pageStart 15 .

<urn:plantdocs:swagelok-ms-01-176:source:section_60> a plm:PCA_100029513 ;
    dcterms:description "CH series seal kits: contain bonded poppet, body seal O-ring, PTFE backup ring and instructions; add a seal material designator to the basic kit number (example SS-3K-CH4-VI)."@en ;
    dcterms:type "text_section" ;
    plm:PCA_100029521 "CH Series Seal Kits" ;
    plm:PCA_100029534 "swagelok-ms-01-176.pdf" ;
    skos:scopeNote "Answers what a CH seal kit contains and how its ordering number is formed."@en ;
    schema:pageStart 15 .

