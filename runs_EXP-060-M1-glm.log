TIONAL MATCH (dt)-[:plm__PCA_100029513]->(src:plm__PCA_100029513)\nRETURN d.tag AS downstream_tag,\n       labels(d) AS labels,\n       d.kind AS kind,\n       dt.plm__PCA_100029521 AS label,\n       dt.plm__PCA_100029522 AS value,\n       coalesce(cs.rdfs__label,'') AS case_label,\n       coalesce(fn.plm__PCA_100029522,'') AS footnote,\n       coalesce(subj.rdfs__label,'') AS subject,\n       coalesce(src.plm__PCA_100029521,'') AS source_title,\n       coalesce(src.dct__description,'') AS source_description,\n       coalesce(toString(src.schema__pageStart), toString(dt.schema__pageStart)) AS page\nLIMIT 200"
