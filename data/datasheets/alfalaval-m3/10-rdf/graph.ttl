    dcterms:description "Product rendering of the Alfa Laval M3 gasketed plate-and-frame heat exchanger: blue frame and pressure plate, plate pack, tightening bolts, four threaded pipe connections, carrying bar and lifting lug."@en ;
    dcterms:type "figure" ;
    plm:PCA_100029521 "(felirat nélkül)" ;
    plm:PCA_100029534 "alfalaval-m3.pdf" ;
