Received notification from DBMS server: <GqlStatusObject gql_status='01N51', status_description='warn: relationship type does not exist. The relationship type `plm__PCA_100029513` does not exist in database `neo4j`. Verify that the spelling is correct.', position=<SummaryInputPosition line=7, column=22, offset=476>, raw_classification='UNRECOGNIZED', classification=<NotificationClassification.UNRECOGNIZED: 'UNRECOGNIZED'>, raw_severity='WARNING', severity=<NotificationSeverity.WARNING: 'WARNING'>, diagnostic_record={'_classification': 'UNRECOGNIZED', '_severity': 'WARNING', '_position': {'offset': 476, 'line': 7, 'column': 22}, 'OPERATION': '', 'OPERATION_CODE': '0', 'CURRENT_SCHEMA': '/'}> for query: "MATCH (c:ProcessInstrumentationFunction {loop_tag: 'FIC-6-2'})-[:send_signal_to*]->(:ActuatingFunction)-[:control]->(v:Valve)\nWITH DISTINCT v.tag AS valve_tag\nMATCH (p:PlantItem {tag: valve_tag})-[:DESCRIBED_BY]->(dev)\nMATCH (d) WHERE d.document_id = dev.document_id AND (d:plm__PCA_100029511 OR d:plm__PCA_100029508 OR d:plm__PCA_100029510)\nOPTIONAL MATCH (d)-[:plm__PCA_100029520]->(cs:plm__PCA_100029524)\nOPTIONAL MATCH (d)-[:plm__PCA_100029514]->(fn)\nOPTIONAL MATCH (d)-[:plm__PCA_100029513]->(src:plm__PCA_100029513)\nWITH valve_tag, dev, d, cs, fn, src\nWHERE toLower(coalesce(d.plm__PCA_100029521,'')) CONTAINS 'seat' OR toLower(coalesce(d.plm__PCA_100029521,'')) CONTAINS 'plug' OR toLower(coalesce(d.plm__PCA_100029521,'')) CONTAINS 'leak'\n   OR toLower(coalesce(d.plm__PCA_100029522,'')) CONTAINS 'seat' OR toLower(coalesce(d.plm__PCA_100029522,'')) CONTAINS 'plug' OR toLower(coalesce(d.plm__PCA_100029522,'')) CONTAINS 'leak'\n   OR toLower(coalesce(cs.rdfs__label,'')) CONTAINS 'seat' OR toLower(coalesce(cs.rdfs__label,'')) CONTAINS 'leak'\n   OR toLower(coalesce(src.plm__PCA_100029521,'')) CONTAINS 'seat' OR toLower(coalesce(src.plm__PCA_100029521,'')) CONTAINS 'plug' OR toLower(coalesce(src.plm__PCA_100029521,'')) CONTAINS 'leak'\n   OR toLower(coalesce(src.dct__description,'')) CONTAINS 'seat' OR toLower(coalesce(src.dct__description,'')) CONTAINS 'plug' OR toLower(coalesce(src.dct__description,'')) CONTAINS 'leak'\nRETURN valve_tag, d.plm__PCA_100029521 AS label, d.plm__PCA_100029522 AS value, cs.rdfs__label AS case_label, fn.plm__PCA_100029522 AS footnote, src.plm__PCA_100029521 AS source_title, src.dct__description AS source_description, src.dct__type AS source_type, src.schema__pageStart AS page, d.schema__pageStart AS datum_page\nORDER BY datum_page\nLIMIT 200"
