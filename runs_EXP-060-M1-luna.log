, c, s, f\n  UNION\n  WITH dev\n  MATCH (d)-[:plm__PCA_100029525]->(s)\n  WHERE d.document_id = dev.document_id\n    AND (d:plm__PCA_100029511 OR d:plm__PCA_100029508 OR d:plm__PCA_100029510)\n    AND (\n      toLower(coalesce(s.plm__PCA_100029521, '')) CONTAINS 'maximum allowable pressure'\n      OR toLower(coalesce(s.dct__description, '')) CONTAINS 'maximum allowable pressure'\n      OR toLower(coalesce(s.plm__PCA_100029521, '')) CONTAINS 'allowable pressure'\n      OR toLower(coalesce(s.dct__description, '')) CONTAINS 'allowable pressure'\n    )\n  OPTIONAL MATCH (d)-[:plm__PCA_100029520]->(c)\n  OPTIONAL MATCH (d)-[:plm__PCA_100029514]->(f)\n  RETURN d, c, s, f\n}\nRETURN item.tag AS tag,\n       d.plm__PCA_100029521 AS label,\n       d.plm__PCA_100029522 AS value,\n       c.rdfs__label AS case,\n       f.plm__PCA_100029522 AS footnote,\n       s.plm__PCA_100029521 AS source_title,\n       s.dct__type AS source_type,\n       s.dct__description AS source_description,\n       d.schema__pageStart AS page\nLIMIT 200"
