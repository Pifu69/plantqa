<urn:plantdocs:alfalaval-m3:source:section_5> a plm:PCA_100029513 ;
    dcterms:description "Bulleted list of five benefits: high energy efficiency (low operating cost), flexible configuration (heat transfer area can be modified), easy installation (compact design), high serviceability (easy to open, easy to clean by CIP) and access to Alfa Laval's global service network."@en ;
    dcterms:type "text_section" ;
    plm:PCA_100029521 "Benefits" ;
    plm:PCA_100029534 "alfalaval-m3.pdf" ;
    skos:scopeNote "Use it to find the claimed benefits of the M3, such as whether its heat transfer area can be modified or whether it can be cleaned by CIP."@en ;
    schema:pageStart 1 .

