<urn:plantdocs:rosemount-3051-00813-0100-4001:source:table_azure_150> a plm:PCA_100029513 ;
    dcterms:description "Rosemount 3051CFA ordering table for configuration buttons: D1 quick service buttons (needs M6 display), D4 analog zero and span (HART output A only), DZ digital zero trim (outputs A and X), all starred."@en ;
    dcterms:type "table" ;
