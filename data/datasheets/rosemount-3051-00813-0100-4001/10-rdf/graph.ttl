<urn:plantdocs:rosemount-3051-00813-0100-4001:source:table_azure_141> a plm:PCA_100029513 ;
    dcterms:description "Rosemount 3051CFA ordering table for sensor fill fluid and O-ring options: L1 inert sensor fill fluid, L2 graphite-filled (PTFE) O-ring, LA both; silicone fill is standard and L1/LA are not available with wireless output X."@en ;
    dcterms:type "table" ;
    plm:PCA_100029521 "Sensor fill fluid and O-ring options (Rosemount 3051CFA ordering information)" ;
    plm:PCA_100029534 "rosemount-3051-00813-0100-4001.pdf" ;
    skos:scopeNote "Use it to find the fill fluid / O-ring option codes for a Rosemount 3051CFA."@en ;
    schema:pageStart 41 .

<urn:plantdocs:rosemount-3051-00813-0100-4001:source:table_azure_143> a plm:PCA_100029513 ;
    dcterms:description "Rosemount 3051CFA ordering table for display and interface options: M6 graphical LCD display (HART output A only), M5 LCD display and M4 LCD display with LOI (outputs A, M and W), all starred."@en ;
    dcterms:type "table" ;
    plm:PCA_100029521 "Display and interface options (Rosemount 3051CFA ordering information)" ;
    plm:PCA_100029534 "rosemount-3051-00813-0100-4001.pdf" ;
    skos:scopeNote "Use it to find the display option code for a Rosemount 3051CFA and which outputs each display needs."@en ;
    schema:pageStart 41 .

<urn:plantdocs:rosemount-3051-00813-0100-4001:source:table_azure_147> a plm:PCA_100029513 ;
    dcterms:description "Rosemount 3051CFA ordering table for manifold for remote mount option: F2 3-valve SST and F6 5-valve SST (starred), F3 3-valve alloy C-276 and F7 5-valve alloy C-276."@en ;
    dcterms:type "table" ;
    plm:PCA_100029521 "Manifold for remote mount option (Rosemount 3051CFA ordering information)" ;
