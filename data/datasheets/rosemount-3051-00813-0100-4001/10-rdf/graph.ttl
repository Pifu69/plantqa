    plm:PCA_100029516 <urn:plantdocs:rosemount-3051-00813-0100-4001:device> ;
    plm:PCA_100029520 <urn:plantdocs:rosemount-3051-00813-0100-4001:case:function_block_control_selector_block_output_protocol_foundation_fieldbus_output_code_f> ;
    plm:PCA_100029521 "Description" ;
    plm:PCA_100029522 "The control selector function block selects one of two or three inputs to be the output. The inputs are normally connected to the outputs of PID or other function blocks. One of the inputs would be considered normal and the other two overrides." ;
    plm:PCA_100029525 <urn:plantdocs:rosemount-3051-00813-0100-4001:source:table_azure_294> ;
    plm:PCA_100029534 "rosemount-3051-00813-0100-4001.pdf" ;
    schema:pageStart 85 .

<urn:plantdocs:rosemount-3051-00813-0100-4001:fact:2771> a plm:PCA_100029508 ;
    plm:PCA_100029514 <urn:plantdocs:rosemount-3051-00813-0100-4001:source:table_azure_293> ;
    plm:PCA_100029516 <urn:plantdocs:rosemount-3051-00813-0100-4001:device> ;
    plm:PCA_100029520 <urn:plantdocs:rosemount-3051-00813-0100-4001:case:function_block_output_splitter_block_output_protocol_foundation_fieldbus_output_code_f> ;
    plm:PCA_100029521 "Description" ;
    plm:PCA_100029522 "The output splitter function block provides the capability to drive two control outputs from a single input. It takes the output of one PID or other control block to control two valves or other actuators." ;
    plm:PCA_100029525 <urn:plantdocs:rosemount-3051-00813-0100-4001:source:table_azure_294> ;
    plm:PCA_100029534 "rosemount-3051-00813-0100-4001.pdf" ;
    schema:pageStart 85 .

