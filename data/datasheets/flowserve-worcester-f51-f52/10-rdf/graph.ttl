<urn:plantdocs:flowserve-worcester-f51-f52:source:section_33> a plm:PCA_100029513 ;
    dcterms:description "Product code position 7 (stem material): 6 stainless steel (footnote 1), Q 17-4PH, 7 Monel, A Alloy 20 and C Hastelloy C (footnote 2)."@en ;
    dcterms:type "text_section" ;
    plm:PCA_100029521 "7. Stem" ;
    plm:PCA_100029534 "flowserve-worcester-f51-f52.pdf" ;
    skos:scopeNote "Use it to find the stem material code of the product code."@en ;
    schema:pageStart 11 .

<urn:plantdocs:flowserve-worcester-f51-f52:source:section_36> a plm:PCA_100029513 ;
    dcterms:description "Product code position 10 (thrust seal): 7 25% glass PTFE, X PEEK, P Fluorofill/Polyfill."@en ;
    dcterms:type "text_section" ;
    plm:PCA_100029521 "10. Thrust seal" ;
    plm:PCA_100029534 "flowserve-worcester-f51-f52.pdf" ;
    skos:scopeNote "Use it to find the thrust seal code of the product code."@en ;
    schema:pageStart 11 .

<urn:plantdocs:flowserve-worcester-f51-f52:source:section_37> a plm:PCA_100029513 ;
    dcterms:description "Product code position 11 (secondary stem seal/O-ring, optional, footnote 3): T V-PTFE, V FKM, P Fluorofill/Polyfill."@en ;
    dcterms:type "text_section" ;
    plm:PCA_100029521 "11. Secondary stem seal/O-ring (optional)(3)" ;
    plm:PCA_100029534 "flowserve-worcester-f51-f52.pdf" ;
    skos:scopeNote "Use it to find the secondary stem seal code of the product code."@en ;
    schema:pageStart 11 .

