<urn:plantdocs:alfalaval-m3:source:fig_1_2> a plm:PCA_100029513 ;
    dcterms:description "Two-column list of the Alfa Laval service portfolio: Start-up (Installation, Installation Supervision, Commissioning), Support (Exclusive Stock, Technical Documentation, Telephone Support, Training, Troubleshooting), Maintenance (Cleaning Services, Reconditioning, Repair, Service Tools, Spare Parts), Improvements (Equipment Upgrades, Redesign, Replacement and Retrofit) and Monitoring (Condition Audit, Performance Audit)."@en ;
    dcterms:type "figure" ;
    plm:PCA_100029521 "(felirat nélkül)" ;
    plm:PCA_100029534 "alfalaval-m3.pdf" ;
    skos:scopeNote "Use it to find which services Alfa Laval offers for the equipment, grouped by service stage."@en ;
    schema:pageStart 1 .

