<urn:plantdocs:flowserve-worcester-f51-f52:source:section_12> a plm:PCA_100029513 ;
    dcterms:description "Seat material Delrin (D), POM or acetal homopolymer: durable, tough, low friction, good creep resistance for high-pressure applications; maximum temperature rating 80 °C (180 °F)."@en ;
    dcterms:type "text_section" ;
    plm:PCA_100029521 "Delrin (D)" ;
    plm:PCA_100029534 "flowserve-worcester-f51-f52.pdf" ;
    skos:scopeNote "Use it to find the properties and maximum temperature of the Delrin seat."@en ;
    schema:pageStart 7 .

<urn:plantdocs:flowserve-worcester-f51-f52:source:section_13> a plm:PCA_100029513 ;
    dcterms:description "Seat material UHMWPE (U), ultra-high molecular weight polyethylene: for applications where PTFE is not suitable (tobacco duty), good abrasion resistance; maximum temperature rating 90 °C (200 °F)."@en ;
    dcterms:type "text_section" ;
    plm:PCA_100029521 "UHMWPE (U)" ;
    plm:PCA_100029534 "flowserve-worcester-f51-f52.pdf" ;
    skos:scopeNote "Use it to find the properties and maximum temperature of the UHMWPE seat."@en ;
    schema:pageStart 7 .

<urn:plantdocs:flowserve-worcester-f51-f52:source:section_14> a plm:PCA_100029513 ;
    dcterms:description "Seat material Virgin PTFE (T): the most common sealing material, excellent chemical resistance and low friction for low operating torque; maximum temperature rating 230 °C (450 °F)."@en ;
    dcterms:type "text_section" ;
    plm:PCA_100029521 "Virgin PTFE (T)" ;
    plm:PCA_100029534 "flowserve-worcester-f51-f52.pdf" ;
    skos:scopeNote "Use it to find the properties and maximum temperature of the virgin PTFE seat."@en ;
    schema:pageStart 7 .

<urn:plantdocs:flowserve-worcester-f51-f52:source:section_15> a plm:PCA_100029513 ;
    dcterms:description "Seat material Reinforced PTFE (R), glass-reinforced: stronger and more wear-resistant than virgin PTFE, for higher pressure/temperature or high cycling; maximum temperature rating 230 °C (450 °F)."@en ;
    dcterms:type "text_section" ;
    plm:PCA_100029521 "Reinforced PTFE (R)" ;
    plm:PCA_100029534 "flowserve-worcester-f51-f52.pdf" ;
    skos:scopeNote "Use it to find the properties and maximum temperature of the reinforced PTFE seat."@en ;
    schema:pageStart 7 .

<urn:plantdocs:flowserve-worcester-f51-f52:source:section_16> a plm:PCA_100029513 ;
    dcterms:description "Seat material Fluorofill/Polyfill (P), PTFE reinforced with carbon, glass and graphite: dimensionally stable, suited to steam and cryogenic services and recommended for modulating control; maximum temperature rating 260 °C (500 °F)."@en ;
    dcterms:type "text_section" ;
    plm:PCA_100029521 "Fluorofill/Polyfill (P)" ;
    plm:PCA_100029534 "flowserve-worcester-f51-f52.pdf" ;
    skos:scopeNote "Use it to find the properties and maximum temperature of the Fluorofill/Polyfill seat."@en ;
    schema:pageStart 7 .

<urn:plantdocs:flowserve-worcester-f51-f52:source:section_17> a plm:PCA_100029513 ;
    dcterms:description "Seat material PEEK (X), polyether ether ketone: the highest P/T rating of the non-metallic seats, very good chemical and abrasion resistance; maximum temperature rating 315 °C (600 °F)."@en ;
    dcterms:type "text_section" ;
