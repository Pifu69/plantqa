<urn:plantdocs:rosemount-3051-00813-0100-4001:source:section_6> a plm:PCA_100029513 ;
    dcterms:description "Overview of Rosemount 3051 diagnostics: the Loop Integrity diagnostic (electrical loop monitoring for corrosion, water in the housing, unstable power supply), the Plugged Impulse Line diagnostic, and the built-in diagnostic log; these are stated to be safety certified."@en ;
