<urn:plantdocs:rosemount-3051-00813-0100-4001:source:section_416> a plm:PCA_100029513 ;
    dcterms:description "Overpressure limits for Rosemount 3051TG/TA by range, from Range 0 60 psi (4.14 bar) to Range 6 24,000 psi (1654.74 bar), plus the note that for 3051L or level flange codes FA, FB, FC, FD, FP and FQ the limit is 0 psia to the flange or sensor rating, whichever is lower."@en ;
    dcterms:type "text_section" ;
    plm:PCA_100029521 "Rosemount 3051TG/TA" ;
    plm:PCA_100029534 "rosemount-3051-00813-0100-4001.pdf" ;
    skos:scopeNote "Use it to find the overpressure limit of a 3051TG/TA transmitter by range, and how the limit is set for 3051L and level flanges (ratings in rosemount-3051-00813-0100-4001/table-4)."@en ;
    schema:pageStart 87 .

