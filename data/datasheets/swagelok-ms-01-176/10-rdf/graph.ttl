<urn:plantdocs:swagelok-ms-01-176:footnote:sw176_t2_fn1> a plm:PCA_100029505 ;
    plm:PCA_100029521 "footnote 1" ;
    plm:PCA_100029522 "To reduce the possibility of dislodging the O-ring in systems where pressure surges, shock, or pulses occur, for all 2C and 4C series valves and for 6C and 8C series valves with cracking pressures lower than 50 psi (3.5 bar), an optional inlet gasket is available. See page 14 for ordering information. Cracking and reseal pressures may decrease slightly from the ranges listed in this catalog. Alternatively, CH or CP series valves should be considered." ;
    plm:PCA_100029534 "swagelok-ms-01-176.pdf" ;
    schema:pageStart 3 .

<urn:plantdocs:swagelok-ms-01-176:source:table_azure_2> a plm:PCA_100029513 ;
    dcterms:description "Working pressure in psig (bar) versus temperature, °F (°C), for 316 SS and brass valves of the C (2C, 4C, 6C and 8C), CA, CP and CPA series, from -10 (-23) to 100 (37) up to 375 (190); brass has no rating above 250 (121). Footnote 1 recommends the optional inlet gasket for surge, shock or pulse service."@en ;
    dcterms:type "table" ;
    plm:PCA_100029521 "Pressure-Temperature Ratings - C (2C, 4C, 6C, and 8C), CA, CP, and CPA Series" ;
    plm:PCA_100029534 "swagelok-ms-01-176.pdf" ;
    skos:scopeNote "Use it to find the working pressure of a 2C, 4C, 6C, 8C, CA, CP or CPA valve in 316 SS or brass at a given temperature."@en ;
    schema:pageStart 3 .

<urn:plantdocs:swagelok-ms-01-176:source:table_azure_3> a plm:PCA_100029513 ;
