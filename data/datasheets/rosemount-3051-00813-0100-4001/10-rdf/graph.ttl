<urn:plantdocs:rosemount-3051-00813-0100-4001:footnote:rm3051_t397_fn1> a plm:PCA_100029505 ;
    plm:PCA_100029521 "footnote 1" ;
    plm:PCA_100029522 "Materials of Construction comply with metallurgical requirements highlighted within NACE MR0175/ISO 15156 for sour oil field production environments. Environmental limits apply to certain materials. Consult latest standard for details. Selected materials also conform to NACE MR0103 for sour refining environments." ;
    plm:PCA_100029534 "rosemount-3051-00813-0100-4001.pdf" ;
    schema:pageStart 67 .

<urn:plantdocs:rosemount-3051-00813-0100-4001:footnote:rm3051_t2_fn1> a plm:PCA_100029505 ;
    plm:PCA_100029521 "footnote 1" ;
    plm:PCA_100029522 "inH2O referenced at 68 ºF (20 ℃). Range 0 only available with Rosemount 3051CD. Range 1 only available with 3051CD, 3051CG, or 3051CF." ;
    plm:PCA_100029534 "rosemount-3051-00813-0100-4001.pdf" ;
    schema:pageStart 81 .

<urn:plantdocs:rosemount-3051-00813-0100-4001:source:table_azure_99> a plm:PCA_100029513 ;
