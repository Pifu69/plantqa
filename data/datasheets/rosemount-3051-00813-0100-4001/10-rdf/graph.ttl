<urn:plantdocs:rosemount-3051-00813-0100-4001:source:section_7> a plm:PCA_100029513 ;
    dcterms:description "Overview of Rosemount 3051 enhanced software: application specific configuration (flow meter with totalizer, level transmitter with volume calculations) and process alerts configurable for any dynamic variable, with custom names and target thresholds, notifying via HART alert or analog output alarm."@en ;
    dcterms:type "text_section" ;
    plm:PCA_100029521 "Enhanced software" ;
    plm:PCA_100029534 "rosemount-3051-00813-0100-4001.pdf" ;
