)-[:plm__PCA_100029520]->(c:plm__PCA_100029524)\n  OPTIONAL MATCH (d)-[:plm__PCA_100029514]->(f)\n  RETURN p.tag AS tag, d.plm__PCA_100029521 AS label,\n         d.plm__PCA_100029522 AS value, c.rdfs__label AS case_label,\n         f.plm__PCA_100029522 AS footnote,\n         s.plm__PCA_100029521 AS source_title, d.schema__pageStart AS page\n}\nRETURN tag, label, value, case_label, footnote, source_title, page\nLIMIT 200"
