<urn:plantdocs:swagelok-ms-01-176:source:section_1> a plm:PCA_100029513 ;
    dcterms:description "Cover page: C, CA, CH, CP and CPA series check valves with working pressures up to 6000 psig (413 bar), adjustable and fixed cracking pressures, a variety of end connections and 316 stainless steel and brass materials."@en ;
    dcterms:type "text_section" ;
    plm:PCA_100029521 "Check Valves" ;
    plm:PCA_100029534 "swagelok-ms-01-176.pdf" ;
    skos:scopeNote "Answers which series the catalog covers and their maximum working pressure, cracking pressure types and materials."@en ;
    schema:pageStart 1 .

<urn:plantdocs:swagelok-ms-01-176:source:section_26> a plm:PCA_100029513 ;
    dcterms:description "Testing: every C, CA, CH, CP and CPA valve is factory tested for crack and reseal; fixed cracking pressure valves are cycled six times before testing, adjustable ones are tested at a low and a high pressure setting; seats have a maximum allowable leak rate of 1 std cm3/min nitrogen."@en ;
    dcterms:type "text_section" ;
    plm:PCA_100029521 "Testing" ;
    plm:PCA_100029534 "swagelok-ms-01-176.pdf" ;
    skos:scopeNote "Answers how the check valves are factory tested and what seat leak rate is allowed."@en ;
    schema:pageStart 10 .

<urn:plantdocs:swagelok-ms-01-176:source:section_62> a plm:PCA_100029513 ;
    dcterms:description "CH spring kits (spring, two cracking pressure labels, instructions; example 302-13K-CH4-1/3), deflector cap kits (one polyethylene cap in red or green) and the Safe Product Selection statement (system designer and user are responsible for function, compatibility, ratings, installation, operation and maintenance)."@en ;
    dcterms:type "text_section" ;
    plm:PCA_100029521 "CH Series Spring Kits" ;
    plm:PCA_100029534 "swagelok-ms-01-176.pdf" ;
    skos:scopeNote "Answers what CH spring and deflector cap kits contain and who is responsible for safe product selection."@en ;
    schema:pageStart 16 .

<urn:plantdocs:swagelok-ms-01-176:source:table_azure_22> a plm:PCA_100029513 ;
    dcterms:description "CH series seal kits in two parts: basic kit ordering numbers per valve series (CH4, CH8, CH16) and valve body material (316 SS, alloy 400), and the seal material designators (Buna N BN, ethylene propylene EP, fluorocarbon FKM VI, neoprene NE)."@en ;
    dcterms:type "table" ;
    plm:PCA_100029521 "CH Series Seal Kits - table 1" ;
    plm:PCA_100029534 "swagelok-ms-01-176.pdf" ;
    skos:scopeNote "Use it to find the basic CH seal kit ordering number and the seal material designator to append."@en ;
    schema:pageStart 15 .

<urn:plantdocs:swagelok-ms-01-176:case:product_variant_c_ca_valve_body_material_316_ss> a plm:PCA_100029524 ;
    rdfs:label "product variant = C, CA; valve body material = 316 SS" .

<urn:plantdocs:swagelok-ms-01-176:footnote:sw176_t1_fn3> a plm:PCA_100029505 ;
    plm:PCA_100029521 "footnote 3" ;
    plm:PCA_100029522 "Maximum back pressure may be limited by the end connection. See Dimensions, page 12." ;
    plm:PCA_100029534 "swagelok-ms-01-176.pdf" ;
    schema:pageStart 3 .

<urn:plantdocs:swagelok-ms-01-176:part:part_poppet> a lis:PhysicalObject ;
    rdfs:label "Poppet" ;
    lis:partOf <urn:plantdocs:swagelok-ms-01-176:device> ;
    skos:notation "2",
        "4",
        "5",
        "Poppet" .

<urn:plantdocs:swagelok-ms-01-176:part:part_spring> a lis:PhysicalObject ;
