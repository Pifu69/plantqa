<urn:plantdocs:swagelok-ms-01-176:source:page_text_14> a plm:PCA_100029513 ;
    dcterms:type "text_section" ;
    plm:PCA_100029521 "(page 14 text)" ;
    plm:PCA_100029534 "swagelok-ms-01-176.pdf" ;
    schema:pageStart 14 .

<urn:plantdocs:swagelok-ms-01-176:source:section_31> a plm:PCA_100029513 ;
    dcterms:description "Ordering note on page 11: basic ordering numbers specify stainless steel; for brass replace SS with B."@en ;
    dcterms:type "text_section" ;
    plm:PCA_100029521 "Ordering Information" ;
    plm:PCA_100029534 "swagelok-ms-01-176.pdf" ;
    skos:scopeNote "Answers how to order a brass C or CA series valve."@en ;
    schema:pageStart 11 .

<urn:plantdocs:swagelok-ms-01-176:source:section_41> a plm:PCA_100029513 ;
    dcterms:description "Ordering note on page 13: basic ordering numbers specify stainless steel; for brass replace SS with B."@en ;
    dcterms:type "text_section" ;
    plm:PCA_100029521 "Ordering Information" ;
    plm:PCA_100029534 "swagelok-ms-01-176.pdf" ;
    skos:scopeNote "Answers how to order a brass CP or CPA series valve."@en ;
    schema:pageStart 13 .

<urn:plantdocs:swagelok-ms-01-176:source:section_51> a plm:PCA_100029513 ;
    dcterms:description "Inlet gasket option for 2C, 4C, 6C and 8C: PTFE-coated 316 SS gaskets reduce O-ring dislodging under pressure surges, shock or pulses; ordered with -FG (example SS-4C-FG-1) when not standard."@en ;
    dcterms:type "text_section" ;
    plm:PCA_100029521 "Inlet Gaskets (2C, 4C, 6C, and 8C Series)" ;
    plm:PCA_100029534 "swagelok-ms-01-176.pdf" ;
    skos:scopeNote "Answers what the inlet gasket is for and how to order it."@en ;
    schema:pageStart 14 .

<urn:plantdocs:swagelok-ms-01-176:source:table_azure_20> a plm:PCA_100029513 ;
    dcterms:description "Whether the inlet gasket is optional or standard for 2C/4C, 6C/8C and 12C/16C series valves, for cracking pressures below and above 50 psig (3.5 bar)."@en ;
    dcterms:type "table" ;
    plm:PCA_100029521 "Inlet Gaskets (2C, 4C, 6C, and 8C Series)" ;
    plm:PCA_100029534 "swagelok-ms-01-176.pdf" ;
    skos:scopeNote "Use it to find whether a given series and cracking pressure comes with a standard or optional inlet gasket."@en ;
    schema:pageStart 14 .

